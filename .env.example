# JSF PM App environment template
# Copy to .env.local and replace placeholders locally. Never commit real values.
# CI, deployment-provider, GitHub, and agent-routing credentials do not belong here.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — jsf-pm-dev for local development
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Required only by narrowly isolated privileged/admin operations.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Local-only development demo data bootstrap password. Never commit real values.
DEV_DEMO_PASSWORD=replace_me_with_local_demo_password

# Resend — transactional email fallback
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=replace-me@example.com

# WhatsApp Business Cloud API / Meta webhook
WHATSAPP_API_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_me
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_me
WHATSAPP_API_VERSION=v21.0

# Upstash QStash + Workflow. For local workflow orchestration, expose the app
# through a tunnel and set UPSTASH_WORKFLOW_URL to its public HTTPS URL.
QSTASH_TOKEN=replace_me
QSTASH_CURRENT_SIGNING_KEY=replace_me
QSTASH_NEXT_SIGNING_KEY=replace_me
UPSTASH_WORKFLOW_URL=https://replace-me.example

# Sentry application runtime DSN. Browser-visible by design.
NEXT_PUBLIC_SENTRY_DSN=https://replace-me@o0.ingest.sentry.io/0
# Optional server-only build/source-map upload configuration; needed only when
# Sentry release upload is enabled.
SENTRY_AUTH_TOKEN=replace_me
SENTRY_ORG=replace_me
SENTRY_PROJECT=replace_me

# =============================================================================
# JSF PM App — Environment Variables Template (.env.example)
# -----------------------------------------------------------------------------
# This file is COMMITTED to the repo as a reference for every secret/key the
# app needs across development, preview, and production.
#
# HOW TO USE:
#   1. Copy this file to `.env.local` (gitignored — lives on your machine only):
#         cp .env.example .env.local
#   2. Replace every placeholder with the REAL value from the service's dashboard.
#   3. NEVER commit `.env.local`, and NEVER paste real secrets into `.env.example`.
#
# Source of truth: jsf-pm-app-development-workflow.md §10 (API Keys & Secrets),
# jsf-pm-app-prd.md (§3.5 config, §9 WhatsApp, OWASP A02/A04/A05).
#
# Golden rule (workflow §10.2): no agent profile ever reads, logs, or displays
# these values. Agents reference them only by NAME (process.env.SUPABASE_...).
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public base URL — used for magic-link redirects, WhatsApp callbacks, OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Postgres database, Auth, realtime, storage)
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  KEY SYSTEM — MODERN (recommended)                                      │
# │                                                                          │
# │  Supabase now uses publishable (`sb_publishable_...`) and secret         │
# │  (`sb_secret_...`) keys that can be created, named, and revoked          │
# │  independently — no shared JWT secret dependency.                        │
# │                                                                          │
# │  The legacy `anon` / `service_role` JWT-based keys still work until      │
# │  end of 2026 but are NOT recommended for new projects.                   │
# │                                                                          │
# │  How to get your keys:                                                   │
# │    Supabase Dashboard → Project Settings → API → API Keys tab            │
# │    → Create new API Key (publishable for client, secret for server).     │
# │                                                                          │
# │  Migration guide:                                                        │
# │    https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
# │                                                                          │
# │  @supabase/ssr clients use the publishable key for BOTH browser and      │
# │  server components (RLS enforces access). The secret key is ONLY for     │
# │  admin / backend code that needs to bypass RLS.                          │
# └──────────────────────────────────────────────────────────────────────────┘
# -----------------------------------------------------------------------------
# Project REST/Realtime URL (safe to expose — client reads it).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Publishable key — safe in the browser. Replaces the legacy `anon` key.
# RLS on the database enforces access control; this key alone cannot read
# rows it shouldn't see. Used by both browser AND server Supabase clients.
# Format: sb_publishable_<22-random-chars>_<8-char-checksum>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret key — SERVER ONLY. Replaces the legacy `service_role` key.
# Bypasses all RLS. Never ship to the client, never expose in browser code.
# Only use in server actions, route handlers, cron jobs, and migrations.
# Format: sb_secret_<22-random-chars>_<8-char-checksum>
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ─ Legacy JWT secret (still needed for custom JWTs like invite links) ─────
# This is the shared secret Supabase Auth uses to sign user-session JWTs
# (access tokens). It's also used to sign custom JWTs (PRD FR-AUTH-03/04/05
# — HS256 signed, role-scoped, expiring invite links).
#
# NOTE: The new publishable/secret API keys above are OPAQUE strings, NOT
# JWTs — they do NOT depend on this JWT_SECRET. The JWT_SECRET is only for
# user-session tokens and custom-signed tokens.
#
# FUTURE: Supabase recommends migrating to JWT signing keys (asymmetric RSA/
# EC keys) for zero-downtime rotation. See:
#   https://supabase.com/docs/guides/auth/signing-keys
# ───────────────────────────────────────────────────────────────────────────
# For now, find it at: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# Resend (transactional email — fallback channel for WhatsApp opt-out clients)
# Get from: Resend Dashboard → API Keys  (PRD §5 notifications, A05)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender identity. Set once Resend is verified; for dev use a personal/proton
# address until joyastarfilms.com email is available (workflow §10.6).
# RESEND_FROM_EMAIL=joyastarfilmsdev@proton.me

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)
# Get from: Meta Business Suite → WhatsApp → API Setup / App Settings
# PRD §9 (Integration Strategy), §A04 webhook signature (X-Hub-Signature-256)
# -----------------------------------------------------------------------------
# Permanent access token for the WhatsApp Business Account (WABA).
WHATSAPP_API_TOKEN=your-permanent-access-token
# Phone number ID (the sender number's ID, not the E.164 digits).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WhatsApp Business Account ID (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Meta App Secret — used to verify inbound webhook signatures
# (sha256 of raw body keyed by this secret → X-Hub-Signature-256).
WHATSAPP_APP_SECRET=your-meta-app-secret
# Webhook verify token — the arbitrary string YOU define when subscribing the
# webhook callback URL in Meta. Distinct from APP_SECRET above.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
# Graph API version for the Cloud API calls (bump as Meta deprecates).
WHATSAPP_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# GitHub (CI/CD pipeline + GitHub MCP used by agents)
# Create a fine-grained PAT: GitHub → Settings → Developer settings → PAT
# Workflow §10.1, §16 (MCP). Store in Hermes ~/.hermes/.env too (ref ${GITHUB_TOKEN}).
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Vercel (deployment — preview per PR, then staging/main)
# Create at: Vercel Dashboard → Settings → Tokens
# Workflow §10.1, Eiael (devops) deploys. Production secrets go in Vercel env vars.
# -----------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-token
# Optional — speeds up Vercel CLI commands (found in project/settings URLs).
# VERCEL_ORG_ID=your-vercel-org-id
# VERCEL_PROJECT_ID=your-vercel-project-id

# -----------------------------------------------------------------------------
# Agent tooling — NOT consumed by the app at runtime.
# Listed per workflow §10.1 for completeness; used by Hermes/OmniRoute model
# routing + CI. Keep in ~/.hermes/.env and/or Vercel/GitHub secrets, not the app.
# -----------------------------------------------------------------------------
OMNIROUTE_API_KEY=your-omniroute-api-key

# -----------------------------------------------------------------------------
# Optional / future phases (leave blank until the feature is built)
# -----------------------------------------------------------------------------
# Direct DB connection string for `psql` seeding (workflow seed.sql script).
# SUPABASE_DB_URL_DEV=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
# Supabase project reference slug (some CLI/SQL contexts).
# SUPABASE_PROJECT_REF=YOUR-PROJECT-ref
# Only if NextAuth is later adopted — Supabase Auth is the primary auth path (PRD §5).
# NEXTAUTH_SECRET=your-nextauth-secret
# Phase 4+ analytics (workflow §11.3 "if needed").
# TINYBIRD_TOKEN=your-tinybird-token
